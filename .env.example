# The only key you need. Free from https://aistudio.google.com/apikey (no credit card)
AI_API_KEY=your-gemini-api-key

# Defaults to Google Gemini's free tier through its OpenAI-compatible endpoint.
# Change the model if AI Studio lists a newer free "Flash" model.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Want to use OpenAI later instead? Swap to:
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Maps use OpenStreetMap (free, no key needed).
